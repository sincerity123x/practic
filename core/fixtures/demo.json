  {
    "model": "core.post",
    "pk": 1,
    "fields": {
      "author": 1,
      "title": "Тихий север",
      "text": "Песня про место, где почти нет людей, зато много неба. Записывал дома, в наушниках слышно, как гудит холодильник.\n\nТекст писал месяц, музыку — два вечера.",
      "tier": 2,
      "created_at": "2026-11-21T23:14:31.713177+00:00"
    }
  },
  {
    "model": "core.post",
    "pk": 2,
    "fields": {
      "author": 1,
      "title": "Демо новой песни",
      "text": "Черновик, который пока нравится больше готовых версий. Оставил один дубль, без обработки и метронома.",
      "tier": null,
      "created_at": "2026-11-21T23:14:31.720248+00:00"
    }
  },
  {
    "model": "core.post",
    "pk": 3,
    "fields": {
      "author": 1,
      "title": "Как я записываю вокал",
      "text": "Микрофон, одеяло на стене и терпение. Рассказываю про настройки, которые у меня не меняются уже год, и про то, как бороться с шипящими.",
      "tier": 1,
      "created_at": "2026-11-21T23:14:31.728044+00:00"
    }
  },
  {
    "model": "core.post",
    "pk": 4,
    "fields": {
      "author": 2,
      "title": "Как рождается город, которого нет",
      "text": "Город начинается с одной линии. Я рисую её очень легко, почти не думая, а потом дорисовываю то, что получилось: улицы, окна и мосты.\n\nНа этом этапе важно не бояться пустоты. Она оставляет место для воздуха и цвета. Ниже покажу, как один и тот же эскиз меняется за четыре шага.",
      "tier": 4,
      "created_at": "2026-11-21T23:14:32.459230+00:00"
    }
  },
  {
    "model": "core.post",
    "pk": 5,
    "fields": {
      "author": 2,
      "title": "Палитра для зимних сцен",
      "text": "Зимний свет почти всегда холоднее, чем кажется. Если взять чистый серый, сцена становится плоской, поэтому я добавляю в тени немного фиолетового.\n\nВ посте — пять сочетаний, которые я использую чаще всего, и короткое объяснение, почему они не выглядят грязно.",
      "tier": null,
      "created_at": "2026-11-21T23:14:32.465215+00:00"
    }
  },
  {
    "model": "core.post",
    "pk": 6,
    "fields": {
      "author": 2,
      "title": "Пять эскизов из блокнота",
      "text": "За неделю набралось пять быстрых зарисовок: двор, трамвай, мост и два наброска людей. Ничего не дорабатывал, оставил как есть.",
      "tier": 3,
      "created_at": "2026-11-21T23:14:32.470205+00:00"
    }
  },
  {
    "model": "core.post",
    "pk": 7,
    "fields": {
      "author": 3,
      "title": "Чистый Python: с чего начать",
      "text": "Начинать стоит не с синтаксиса, а с привычек: короткие функции, понятные имена, никаких глобальных переменных.\n\nВ посте — пять правил, которые экономят больше времени, чем любой линтер.",
      "tier": null,
      "created_at": "2026-11-21T23:14:33.264130+00:00"
    }
  },
  {
    "model": "core.post",
    "pk": 8,
    "fields": {
      "author": 3,
      "title": "Разбор задачи про скобки",
      "text": "Классическая задача на стек. Разбираю три решения: наивное, аккуратное и то, которое приятно читать через полгода.",
      "tier": 6,
      "created_at": "2026-11-21T23:14:33.269116+00:00"
    }
  },
  {
    "model": "core.post",
    "pk": 9,
    "fields": {
      "author": 4,
      "title": "Утро в чужом городе",
      "text": "Просыпаешься в незнакомой квартире и первые минуты не понимаешь, где ты. Потом слышишь трамвай и вспоминаешь.",
      "tier": null,
      "created_at": "2026-11-21T23:14:33.979028+00:00"
    }
  },
  {
    "model": "core.post",
    "pk": 10,
    "fields": {
      "author": 4,
      "title": "Письма, которые не отправила",
      "text": "Несколько писем, которые я писала и не решалась отправить. Собрала их в один текст, ничего не меняя.",
      "tier": 9,
      "created_at": "2026-11-21T23:14:33.984222+00:00"
    }
  },
  {
    "model": "core.post",
    "pk": 11,
    "fields": {
      "author": 4,
      "title": "Пять книг про дорогу",
      "text": "Подборка для тех, кто любит медленные истории, где почти ничего не происходит, но уезжать не хочется.",
      "tier": null,
      "created_at": "2026-11-21T23:14:33.989790+00:00"
    }
  },
  {
    "model": "core.post",
    "pk": 12,
    "fields": {
      "author": 4,
      "title": "Черновик рассказа",
      "text": "Первый вариант, который ещё не показывал редактору. Буду рад замечаниям в комментариях.",
      "tier": 8,
      "created_at": "2026-11-21T23:14:33.996439+00:00"
    }
  },
  {
    "model": "core.post",
    "pk": 13,
    "fields": {
      "author": 5,
      "title": "Плёнка зимой",
      "text": "Снимал на 400 единиц при минус десяти. Половина кадров ушла в брак, зато оставшиеся выглядят так, как я хотел.",
      "tier": null,
      "created_at": "2026-11-21T23:14:34.691126+00:00"
    }
  },
  {
    "model": "core.post",
    "pk": 14,
    "fields": {
      "author": 5,
      "title": "Прогулка по набережной",
      "text": "Час до заката, пустая набережная и один чай в термосе. Двенадцать кадров, из них удачных — четыре.",
      "tier": 10,
      "created_at": "2026-11-21T23:14:34.697110+00:00"
    }
  },
  {
    "model": "core.post",
    "pk": 15,
    "fields": {
      "author": 6,
      "title": "Выпуск 12: книги о зиме",
      "text": "Говорим о трёх книгах, где зима — не фон, а действующее лицо. Плюс короткий разговор о том, зачем вообще читать про холод.",
      "tier": 13,
      "created_at": "2026-11-21T23:14:35.372489+00:00"
    }
  },
  {
    "model": "core.post",
    "pk": 16,
    "fields": {
      "author": 6,
      "title": "Разговор с переводчиком",
      "text": "О том, как переводить шутки, которые не работают на другом языке, и почему иногда лучше потерять смысл, чем ритм.",
      "tier": null,
      "created_at": "2026-11-21T23:14:35.380468+00:00"
    }
  },
  {
    "model": "core.post",
    "pk": 17,
    "fields": {
      "author": 6,
      "title": "Что читать в декабре",
      "text": "Пять коротких книг на месяц, когда хочется читать, но не хочется думать.",
      "tier": 12,
      "created_at": "2026-11-21T23:14:35.388447+00:00"
    }
  },
